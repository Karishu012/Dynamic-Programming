Frog Jump:(Memoization)
import java.util.*;
public class Solution{
public static int frogjump(int n,int[] heights)
{
Scanner sc=new Scanner(System.in);
n=sc.nextInt();
int[] dp=new int[n+1];
for(int i=0;i<=n;i++)
{
dp[i]=-1;
}
return fj(n-1,heights,dp);
}
Static int fj(int n,int[] heights,int[] dp)
{
if(n==0)return 0;
if(dp[n]!=-1)return dp[n];
int left=fj(n-1,heights,dp)+Math.abs(heights[n]-heights[n-1]);
int right=Integer.MAX_VALUE;
if(n>1){
right=fj(n-2,heights,dp)+Math.abs(heights[n]-heights[n-2]);
}
dp[n]=Math.min(left,right);
return dp[n];
}}
