House Robber
public class Solution {
public static int maxMoneyLooted(int[] houses) {
int n = houses.length;
// Edge cases
if(n == 0)
return 0;
if(n == 1)
return houses[0];
int prev = houses[0];
int prev2 = 0;
for(int i = 1; i < n; i++) {
int pick = houses[i];
if(i > 1) {
pick += prev2;
}
int notPick = prev;
int curr = Math.max(pick, notPick);
prev2 = prev;
prev = curr;
}
return prev;
}
}
INPUT:
4
10 2 3 11
OUTPUT:
21
TIME COMPLEXITY:O(N)
SPACE COMPLEXITY:O(1)
