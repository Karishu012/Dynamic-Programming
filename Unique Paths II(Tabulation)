import java.util.*;
public class Solution {
    static int mod=1000000007;
    static int mazeObstacles(int n, int m, ArrayList<ArrayList<Integer>> mat) {
        // Write your code here.
        int[][] dp=new int[n][m];
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
               if(i>=0 && j>=0 && mat.get(i).get(j)==-1){
               dp[i][j]=0;
               continue; 
               }
                if(i==0 && j==0){
               dp[i][j]=1;
               continue;
                }
               int up=0,left=0;
               if(i>0)
                up=dp[i-1][j];
               if(j>0)
               left=dp[i][j-1];
             dp[i][j]=(left+up)%mod;
            }
        }
        return dp[n-1][m-1];
    }
}
