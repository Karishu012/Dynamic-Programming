import java.util.*;
public class Solution {
    static int mod=1000000007;
    static int mazeObstacles(int n, int m, ArrayList<ArrayList<Integer>> mat) {
        // Write your code here.
        int[] prev=new int[m];
        for(int i=0;i<n;i++)
        {
            int[] curr=new int[m];
            for(int j=0;j<m;j++)
            {
               if(i>=0 && j>=0 && mat.get(i).get(j)==-1){
               curr[j]=0;
               continue; 
               }
                if(i==0 && j==0){
               curr[j]=1;
               continue;
                }
               int up=0,left=0;
               if(i>0)
                up=prev[j];
               if(j>0)
               left=curr[j-1];
             curr[j]=(left+up)%mod;
            }
            prev=curr;
        }
        return prev[m-1];
    }
}
