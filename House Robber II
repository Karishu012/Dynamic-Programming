House Robber II
import java.util.* ;
import java.io.*;
public class Solution {
public static int maxMoneyLooted(int[] houses, int start, int end) {
int prev = houses[start];
int prev2 = 0;
for(int i = start + 1; i <= end; i++) {
int pick = houses[i];
if(i > start + 1) {
pick += prev2;
}
int notPick = prev;
int curr = Math.max(pick, notPick);
prev2 = prev;
prev = curr;
}
return prev;
}
public static long houseRobber(int[] valueInHouse) {
int n = valueInHouse.length;
if(n == 0)
return 0
if(n == 1)
return valueInHouse[0];
// Exclude last house
long ans1 = maxMoneyLooted(valueInHouse, 0, n - 2);
// Exclude first house
long ans2 = maxMoneyLooted(valueInHouse, 1, n - 1);
return Math.max(ans1, ans2);
}
}
INPUT:
4
10 2 3 11
OUTPUT:
21
TIME COMPLEXITY:O(N)
SPACE COMPLEXITY:O(1)
