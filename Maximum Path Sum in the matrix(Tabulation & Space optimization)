        int n=matrix.length;
        int m=matrix[0].length;
        int[][] dp=new int[n][m];
        for(int j=0;j<m;j++)
        {
            dp[0][j]=matrix[0][j];
        }
        for(int i=1;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
        int u=matrix[i][j]+dp[i-1][j];
        int dl=matrix[i][j];
        if(j-1>=0){
             dl+=dp[i-1][j-1];
        }
        else dl+=(int) -1e9;
        int dr=matrix[i][j];
        if(j+1<m) {
            dr+=dp[i-1][j+1];
        }
        else dr+=(int) -1e9;
        dp[i][j]=Math.max(u,Math.max(dl,dr));   
            }
        }
        int maxi=Integer.MIN_VALUE;
        for(int j=0;j<m;j++)
        {
            maxi=Math.max(maxi,dp[n-1][j]);
        }
        return maxi;
    }
}
Maximum Path Sum in the matrix(Space optimization)
import java.util.* ;
import java.io.*; 

public class Solution {
    public static int getMaxPathSum(int[][] matrix) {
        // Write your code here
        int n=matrix.length;
        int m=matrix[0].length;
        int[] prev=new int[m];
        for(int j=0;j<m;j++)
        {
            prev[j]=matrix[0][j];
        }
        for(int i=1;i<n;i++)
        {
            int[] curr=new int[m];
            for(int j=0;j<m;j++)
            {
        int u=matrix[i][j]+prev[j];
        int dl=matrix[i][j];
        if(j-1>=0){
             dl+=prev[j-1];
        }
        else dl+=(int) -1e9;
        int dr=matrix[i][j];
        if(j+1<m) {
            dr+=prev[j+1];
        }
        else dr+=(int) -1e9;
        curr[j]=Math.max(u,Math.max(dl,dr));    
            }
            prev=curr;
        }
        int maxi=Integer.MIN_VALUE;
        for(int j=0;j<m;j++)
        {
            maxi=Math.max(maxi,prev[j]);
        }
        return maxi;
    }
}
