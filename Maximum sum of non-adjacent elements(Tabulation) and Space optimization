import java.util.* ;
import java.io.*;
import java.util.*;
public class Solution {
public static int maximumNonAdjacentSum(ArrayList<Integer> nums) {
// Write your code here.
int n=nums.size();
if(n == 1)
            return nums.get(0);
int prev=nums.get(0);
int prev2=0;
for(int i=1;i<n;i++)
{
int pick=nums.get(i);
if(i>1)
{
pick+=prev2;
}
int npick=prev;
int curr=Math.max(pick,npick);
prev2=prev;
prev=curr;
}
return prev;
}
}
TIME COMPLEXITY:O(N)
SPACE COMPLEXITY:O(1)
