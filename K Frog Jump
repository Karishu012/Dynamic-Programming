	K Frog Jump:
class Solution {
public int frogJump(int[] heights, int k) {
int n=heights.length;
int[] dp=new int[n+1];
dp[0]=0;
for(int i=1;i<n;i++)
{
int minsteps=Integer.MAX_VALUE;;
for(int j=1;j<=k;j++)
{
if(i-j>=0)
{
int jump=dp[i-j]+Math.abs(heights[i]-heights[i-j]);
minsteps=Math.min(minsteps,jump);
}
}
dp[i]=minsteps;
}
return dp[n-1];
}
}
Input:
heights = [10, 40, 50, 20]
k = 3
Output:
10
Time complexity:O(N)
Space Complexity:O(N)
